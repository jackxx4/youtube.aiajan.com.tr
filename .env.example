# YouTube Keşif - ortam değişkenleri örneği
# Gerçek anahtarlarınızı buraya yazmadan önce hosting panelinin güvenli Environment Variables alanını tercih edin.
# Bu dosya yalnızca isimleri ve yer tutucuları gösterir; değerler şu anda TANIMLI DEĞİLDİR.

APP_URL=https://youtube.aiajan.com.tr
APP_ENV=production

# Google OAuth 2.0 - Google Cloud Console'dan alınacak
GOOGLE_CLIENT_ID=BURAYA_YAZILACAK
GOOGLE_CLIENT_SECRET=BURAYA_YAZILACAK
GOOGLE_REDIRECT_URI=https://youtube.aiajan.com.tr/callback.php

# YouTube Data API v3 - Google Cloud Console'dan alınacak
YOUTUBE_API_KEY=BURAYA_YAZILACAK

# MySQL hosting bilgileri - hosting sağlayıcısından alınacak
DB_HOST=localhost
DB_NAME=BURAYA_YAZILACAK
DB_USER=BURAYA_YAZILACAK
DB_PASSWORD=BURAYA_YAZILACAK

# Sunucuda üretilecek 32 byte anahtar; GitHub'a gerçek anahtar koymayın
TOKEN_ENCRYPTION_KEY=BURAYA_YAZILACAK

# Gönüllü katkı/ödeme sağlayıcısı henüz seçilmedi.
# Sağlayıcı seçildiğinde dokümantasyona göre doldurulacak.
CONTRIBUTION_PROVIDER=BURAYA_YAZILACAK
CONTRIBUTION_API_KEY=BURAYA_YAZILACAK
CONTRIBUTION_API_SECRET=BURAYA_YAZILACAK
CONTRIBUTION_WEBHOOK_SECRET=BURAYA_YAZILACAK
